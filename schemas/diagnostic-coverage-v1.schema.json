{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCRYVEIL owner diagnostic coverage v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "scryveil.diagnostic-coverage/1"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "const": "verified_selected_snapshot_only"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "imported_artifacts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "artifacts_without_selected_events": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "diagnostic_categories": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000
      }
    },
    "not_observed_in_snapshot": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000
      }
    },
    "schema_status": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000
      }
    },
    "interpretation_status": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000
      }
    },
    "events_without_source_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "source_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^artifact-[a-f0-9]{64}$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "artifact_id",
          "line",
          "code"
        ],
        "additionalProperties": false
      }
    },
    "unimported_or_rejected_files": {
      "const": "unknown_not_recorded"
    },
    "rejected_record_count": {
      "type": "null"
    },
    "limits": {
      "type": "object",
      "properties": {
        "case_artifacts": {
          "const": 1024
        },
        "case_events": {
          "const": 20000
        },
        "snapshot_selection": {
          "const": "earliest_known_times_then_unknown"
        }
      },
      "required": [
        "case_artifacts",
        "case_events",
        "snapshot_selection"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    }
  },
  "required": [
    "schema_version",
    "snapshot_sha256",
    "source_state_sha256",
    "scope",
    "coverage",
    "imported_artifacts",
    "artifacts_without_selected_events",
    "diagnostic_categories",
    "not_observed_in_snapshot",
    "profiles",
    "schema_status",
    "interpretation_status",
    "events_without_source_time",
    "source_warnings",
    "unimported_or_rejected_files",
    "rejected_record_count",
    "limits",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "Coverage": {
      "type": "object",
      "properties": {
        "total_events": {
          "type": "integer",
          "minimum": 0
        },
        "selected_events": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_events": {
          "type": "integer",
          "minimum": 0
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "not_collected_or_supported": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "real_export_qualification": {
          "const": "open"
        },
        "clock_accuracy": {
          "const": "unknown"
        },
        "same_device_identity": {
          "const": "unverified"
        },
        "complete_device_history": {
          "const": false
        },
        "selection": {
          "enum": [
            "full_case_fail_on_capacity",
            "earliest_event_cap"
          ]
        },
        "collection_archives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "collection_member_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "selected_event_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "selected_diagnostic_schema_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "total_events",
        "selected_events",
        "omitted_events",
        "families",
        "not_collected_or_supported",
        "real_export_qualification",
        "clock_accuracy",
        "same_device_identity",
        "complete_device_history"
      ],
      "additionalProperties": false
    }
  }
}
