{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCRYVEIL provider configuration v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "scryveil.provider/1"
    },
    "adapter": {
      "enum": [
        "mock",
        "chat-completions-json",
        "messages-tools"
      ]
    },
    "mode": {
      "enum": [
        "offline",
        "local",
        "remote"
      ]
    },
    "endpoint": {
      "type": "string",
      "maxLength": 1024
    },
    "model": {
      "type": "string",
      "maxLength": 1024
    },
    "api_key_env": {
      "type": "string",
      "pattern": "^SCRYVEIL_[A-Z0-9_]{1,64}$"
    },
    "input_usd_per_million": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "output_usd_per_million": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "max_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "max_context_bytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 262144
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 128,
      "maximum": 8192
    },
    "max_total_tokens": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 200000
    },
    "native_tool_layout": {
      "enum": [
        "individual-v1",
        "routed-v1"
      ]
    },
    "messages_profile": {
      "const": "minimax-v1"
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "base_url": {
      "type": "string",
      "maxLength": 1024,
      "description": "SDK-style base: append /chat/completions for Chat Completions, /v1/messages for Messages. Use endpoint for an exact custom route."
    },
    "auth_scheme": {
      "enum": [
        "bearer",
        "x-api-key"
      ]
    }
  },
  "required": [],
  "additionalProperties": false,
  "description": "Omitted fields use runtime defaults. Runtime additionally enforces adapter/mode combinations, private file permissions, unambiguous URL routing, loopback/public destination restrictions and consent. Base URLs normalize to exact disclosed endpoints. No inline credential is accepted.",
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "enum": [
              "chat-completions-json",
              "messages-tools"
            ]
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "required": [
          "model",
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "local",
              "remote"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "endpoint"
            ]
          },
          {
            "required": [
              "base_url"
            ]
          }
        ]
      },
      "else": {
        "properties": {
          "mode": {
            "const": "offline"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "endpoint"
              ]
            },
            {
              "required": [
                "model"
              ]
            },
            {
              "required": [
                "api_key_env"
              ]
            },
            {
              "required": [
                "input_usd_per_million"
              ]
            },
            {
              "required": [
                "output_usd_per_million"
              ]
            },
            {
              "required": [
                "base_url"
              ]
            },
            {
              "required": [
                "auth_scheme"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "native_tool_layout"
        ]
      },
      "then": {
        "required": [
          "adapter"
        ],
        "properties": {
          "adapter": {
            "const": "messages-tools"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "messages_profile"
        ]
      },
      "then": {
        "required": [
          "adapter",
          "reasoning_effort"
        ],
        "properties": {
          "adapter": {
            "const": "messages-tools"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reasoning_effort"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "messages_profile"
            ]
          },
          {
            "required": [
              "adapter"
            ],
            "properties": {
              "adapter": {
                "const": "chat-completions-json"
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
